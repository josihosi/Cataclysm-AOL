      "label": "disable_safe_mode",
      "keys": ["!"],
      "settle_seconds": 0.5,
      "capture_after": true,
      "extract_text_after_capture": true,
      "extract_text_tail_lines": 12
    },
    {
      "kind": "advance_turns",
      "label": "advance_10_turns_for_return_home_decision",
