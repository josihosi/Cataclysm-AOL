    "platform": ["macos"],
    "profile": "dev-harness",
    "fixture": "bandit_local_scout_return_preaged_v0_2026-04-27",
    "requirements": {
      "os": "macos",
      "source": "current-worktree",
      "executable": "cataclysm-tiles",
      "profile": "dev-harness",
      "fixture": "bandit_local_scout_return_preaged_v0_2026-04-27",
      "helper": "Peekaboo",
      "peekaboo": true,
      "input": ["press:!", "press:."],
      "ocr": true,
      "cleanup": true
    },
    "grants_gameplay_proof": false
  },
  "proof_route": {
