{
  "manifest_version": 2,
  "name": "harness.ergonomics_native_mcw",
  "description": "Disposable zero-credit diagnostic of whether an LLM can understand and operate native game surfaces through the player CLI without implementation archaeology.",
  "profile": "harness-ergonomics",
  "config_profile": "dev-harness",
  "world": "McWilliams",
  "fixture": "r_surface_001_inventory_prompt_v1",
  "fixture_profile": "live-debug",
  "installed_save_player": "#Wm9yYWlkYSBWaWNr.sav.zzip",
  "replace_existing_worlds": true,
  "suppress_profile_startup_input": true,
  "run_class": "non_combat",
  "observer_character": true,
  "capabilities": {
    "runtime.entry_mode": "cockpit_live_session",
    "capabilities.playtest.ergonomics": "native_free_play"
  },
  "runtime_contract": {
    "permitted_input": [
      "frame-bound semantic requests",
      "cockpit:game.act",
      "cockpit:game.wait",
      "cockpit:run.witness",
      "cockpit:run.finish"
    ],
    "forbidden_input": [
      "guessed-key",
      "physical-key",
      "keyboard",
      "mouse",
      "focus",
      "ocr",
      "screen-coordinate",
      "direct-state-mutation"
    ],
    "setup_only_debug": false,
    "disposable_copy": true,
    "helpers": [],
    "permissions": [],
    "platform": [
      "macos"
    ],
    "profile": "harness-ergonomics",
    "config_profile": "dev-harness",
    "fixture": "r_surface_001_inventory_prompt_v1",
    "requirements": {
      "os": "macos",
      "source": "current-worktree",
      "executable": "cataclysm-tiles",
      "profile": "harness-ergonomics",
      "fixture": "r_surface_001_inventory_prompt_v1",
      "helper": "none",
      "peekaboo": false,
      "input": [
        "frame-bound semantic requests"
      ],
      "ocr": false,
      "cleanup": true
    },
    "grants_gameplay_proof": false
  },
  "source_binding": {
    "fixture_manifest": "tools/openclaw_harness/fixtures/saves/live-debug/r_surface_001_inventory_prompt_v1/manifest.json",
    "profile": "tools/openclaw_harness/profiles/dev-harness.json",
    "profile_snapshot": "tools/openclaw_harness/fixtures/saves/live-debug/bandit_basecamp_prepared_base_v1_2026-04-22/manifest.json"
  },
  "steps": [
    {
      "kind": "native_semantic_bootstrap",
      "label": "bind_ergonomics_native_world",
      "native_semantic_checkpoint": {
        "required_actions": [
          "world.wait"
        ],
        "required_state": "world",
        "require_initial_hud_world_ready_frame": false
      }
    },
    {
      "kind": "cockpit_live_session",
      "label": "operate_ergonomics_native_world",
      "cleanup_on_finish": true,
      "objective": "Explore what the current player can perceive and do. Choose a useful short native wait and a nested interface to investigate, notice changes or player concerns, and explain what actually happened. Exercise saving and leaving the game if the current input owners support it; expose any missing operation or contradictory outcome instead of claiming success. Choose the trajectory yourself and finish with a truthful witness. This run earns zero product-feature credit.",
      "proof_targets": [
        "understandable current player state and native input owner",
        "frame-bound native action receipts and resulting state",
        "a truthful account of observed outcomes and missing information",
        "honest save and exit status, independent of accepted input",
        "cleanup disposition"
      ],
      "authority": [
        "currently advertised native semantic actions",
        "game.act",
        "game.wait",
        "run.witness",
        "run.finish"
      ],
      "invariants": [
        "fixture setup and all diagnostic results earn zero feature credit",
        "no fabricated game state or gameplay result",
        "native input ownership remains authoritative",
        "preserve contradictions and distinguish receipt acceptance from game outcomes"
      ],
      "live_operations": [
        "game.act",
        "game.wait"
      ],
      "transition_timeout_seconds": 15.0,
      "observe_interval_seconds": 0.1
    }
  ],
  "proof_gates": [
    {
      "id": "ergonomics_native_session",
      "label": "source-bound native ergonomics diagnostic session",
      "boundary_step": "operate_ergonomics_native_world",
      "predecessors": [],
      "expectations": [
        {
          "kind": "saved_artifact",
          "predicate": {
            "artifact_kind": "worker_controlled_live_cockpit_session",
            "gameplay_credit": false
          }
        }
      ],
      "checkpoint_safe_ui": {
        "screen_text_contains": [
          "Move:"
        ]
      }
    }
  ],
  "proof_route": {
    "gates": [
      "ergonomics_native_session"
    ],
    "terminal": [
      "ergonomics_native_session"
    ]
  },
  "semantic_only_startup": true,
  "profile_snapshot": "bandit_basecamp_prepared_base_v1_2026-04-22",
  "profile_snapshot_profile": "live-debug",
  "profile_option_overrides": {
    "LLM_INTENT_ENABLE": "false"
  }
}
