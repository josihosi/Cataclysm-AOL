+func _execute_ollama_setup_step(step: Dictionary, endpoint: String, setup_fixture: String = "") -> Dictionary:
+	var phase = str(step.get("phase", "ollama_setup"))
+	var command = str(step.get("command", ""))
+	var args = step.get("args", [])
+	var output = []
+	var exit_code = 0
+	var process_id = 0
+	if setup_fixture != "":
+		if setup_fixture == "installer_cancelled" and phase == "install_ollama_runtime":
+			exit_code = 1223
+			output.append("user cancelled installer")
+		elif setup_fixture == "installer_privilege" and phase == "install_ollama_runtime":
+			exit_code = 5
+			output.append("Access is denied; administrator permission required")
+		elif (setup_fixture == "installer_fail" and phase == "install_ollama_runtime") or (setup_fixture == "server_start_fail" and phase == "start_ollama_server") or (setup_fixture == "pull_fail" and phase.begins_with("pull")):
+			exit_code = 37
+			output.append("fixture failure for %s" % phase)
+		else:
+			if phase == "install_ollama_runtime" and setup_fixture != "install_cli_missing":
+				OS.set_environment("LACAPULT_OLLAMA_FIXTURE", "server_unreachable")
+			elif phase == "start_ollama_server":
+				OS.set_environment("LACAPULT_OLLAMA_FIXTURE", "models:")
+			elif phase == "pull_selected_model":
+				OS.set_environment("LACAPULT_OLLAMA_FIXTURE", "models:%s" % str(args[1]))
+			elif phase == "pull_nemotron_source":
