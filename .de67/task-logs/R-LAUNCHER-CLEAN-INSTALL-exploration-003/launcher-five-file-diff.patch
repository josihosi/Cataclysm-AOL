+func _ollama_server_start_step(platform: String = "", endpoint: String = DEFAULT_OLLAMA_URL) -> Dictionary:
+	var target_platform = platform if platform != "" else OS.get_name()
+	if target_platform == "OSX":
+		if _normalize_ollama_endpoint(endpoint) != DEFAULT_OLLAMA_URL:
+			return {"phase": "start_ollama_server", "command": "ollama", "args": ["serve"], "process_wait": false, "purpose": "Start Ollama on the selected local endpoint."}
+		var app_path = OS.get_environment("HOME").plus_file("Applications").plus_file("Ollama.app")
+		if Directory.new().dir_exists("/Applications/Ollama.app"):
+			app_path = "/Applications/Ollama.app"
+		if Directory.new().dir_exists(app_path):
+			return {"phase": "start_ollama_server", "command": "open", "args": ["-a", app_path], "purpose": "Start the official macOS Ollama app, which starts the local server."}
+		return {"phase": "start_ollama_server", "command": "ollama", "args": ["serve"], "process_wait": false, "purpose": "Start the installed Ollama server process."}
+	if target_platform == "Windows":
+		var cli = _ps_quote(_ollama_cli_command())
+		var host = _ps_quote(_normalize_ollama_endpoint(endpoint))
+		var start_script = "$env:OLLAMA_HOST='%s'; Start-Process -WindowStyle Hidden -FilePath '%s' -ArgumentList 'serve'" % [host, cli]
+		return {"phase": "start_ollama_server", "command": _windows_powershell_executable(), "args": ["-NoProfile", "-Command", start_script], "purpose": "Start the installed Ollama server in the user session at the selected endpoint."}
+	if target_platform == "X11" or target_platform == "Server":
+		var systemctl_available = _command_exists("systemctl")
+		var system_service_available = systemctl_available and _ollama_systemd_service_available()
+		return _ollama_linux_server_start_step(endpoint, systemctl_available, system_service_available, _command_exists("pkexec"))
+	return {}
+
+
+func _ollama_linux_server_start_step(endpoint: String, systemctl_available: bool, system_service_available: bool, pkexec_available: bool) -> Dictionary:
+	if _normalize_ollama_endpoint(endpoint) == DEFAULT_OLLAMA_URL and systemctl_available and system_service_available:
+		if pkexec_available:
+			return {"phase": "start_ollama_server", "command": "pkexec", "args": ["systemctl", "start", "ollama.service"], "purpose": "Start the installed Ollama systemd service through the desktop privilege prompt."}
+		return {"phase": "start_ollama_server", "command": "systemctl", "args": ["start", "ollama.service"], "purpose": "Start the detected Ollama systemd service; privilege errors are reported without pulling a model."}
+	var purpose = "Start Ollama in the current user session on the selected local endpoint."
+	if _normalize_ollama_endpoint(endpoint) == DEFAULT_OLLAMA_URL and systemctl_available and not system_service_available:
+		purpose = "No loaded Ollama systemd service was detected; start ollama serve in the current user session instead."
+	return {"phase": "start_ollama_server", "command": "ollama", "args": ["serve"], "process_wait": false, "purpose": purpose}
+
