+			elif phase == "create_nemotron_no_think_alias":
+				OS.set_environment("LACAPULT_OLLAMA_FIXTURE", "models:%s,%s" % [OLLAMA_MODEL_NEMOTRON_SOURCE, OLLAMA_MODEL_NEMOTRON])
+	else:
+		if command == "write_file":
+			exit_code = _write_text_file(str(args[0]), str(step.get("content", "")), output)
+		elif command == "ollama":
+			var wait_for_exit = step.get("process_wait", true)
+			var command_result = _execute_ollama_command(args, endpoint, output, wait_for_exit)
+			if wait_for_exit:
