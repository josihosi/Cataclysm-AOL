+func _ollama_macos_shell_script(shell_command: String, administrator: bool = false) -> String:
+	var script = "do shell script \\\"%s\\\"" % shell_command.replace("\\", "\\\\").replace("\"", "\\\"")
+	if administrator:
+		script += " with administrator privileges"
+	return script
