+			steps.append({"phase": "write_nemotron_no_think_modelfile", "command": "write_file", "args": [modelfile_path], "content": _ollama_nemotron_modelfile_text(), "purpose": "Write the no-think Nemotron alias Modelfile."})
+			steps.append({"phase": "create_nemotron_no_think_alias", "command": "ollama", "args": ["create", OLLAMA_MODEL_NEMOTRON, "-f", modelfile_path], "purpose": "Create the no-think Nemotron alias, reusing source model blobs."})
