+func _ollama_installer_step(platform: String = "") -> Dictionary:
+	var target_platform = platform if platform != "" else OS.get_name()
+	if target_platform == "OSX":
+		if _command_exists("curl") and _command_exists("osascript"):
+			var install_script = _ollama_macos_shell_script("curl -fsSL https://ollama.com/install.sh | OLLAMA_NO_START=1 sh", true)
+			return {"phase": "install_ollama_runtime", "command": "osascript", "args": ["-e", install_script], "installer": "official_macos_installer", "purpose": "Run Ollama's official macOS installer with the native administrator prompt; the launcher starts Ollama as the signed-in user afterward."}
+		return {}
+	if target_platform == "Windows":
+		return {"phase": "install_ollama_runtime", "command": _windows_powershell_executable(), "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "irm https://ollama.com/install.ps1 | iex"], "installer": "official_powershell_installer", "purpose": "Run Ollama's official per-user Windows installer."}
+	if target_platform == "X11" or target_platform == "Server":
+		if _command_exists("curl") and _command_exists("sh"):
+			if _command_exists("pkexec"):
+				return {"phase": "install_ollama_runtime", "command": "pkexec", "args": ["sh", "-c", "curl -fsSL https://ollama.com/install.sh | sh"], "installer": "official_linux_install_script", "purpose": "Run Ollama's official Linux installer through the desktop privilege prompt."}
+			return {"phase": "install_ollama_runtime", "command": "sh", "args": ["-c", "curl -fsSL https://ollama.com/install.sh | sh"], "installer": "official_linux_install_script", "purpose": "Run Ollama's official Linux installer; it requests sudo when system installation requires it."}
+	return {}
