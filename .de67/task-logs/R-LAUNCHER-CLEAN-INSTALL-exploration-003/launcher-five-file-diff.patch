+func _ollama_systemd_service_available() -> bool:
+	var output = []
+	var exit_code = OS.execute("systemctl", ["show", "-p", "LoadState", "ollama.service"], true, output, true)
+	if exit_code != 0:
+		return false
+	return "\n".join(output).find("LoadState=loaded") >= 0
